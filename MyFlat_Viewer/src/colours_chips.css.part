@media (max-width: 760px) { #wcPanel { width: auto; left: 8px; right: 8px; max-height: 55%; top: auto; bottom: 8px; } .wc-pop { left: 8px; right: 8px; width: auto; top: 8px; } }
.wc-chips { display: flex; flex-wrap: wrap; gap: 4px; }
.wc-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px 3px 4px; border-radius: 8px; border: 1px solid var(--line); background: #fff; font-size: 11.5px; cursor: pointer; }
.wc-chip.on { border-color: #1f6f54; box-shadow: 0 0 0 2px #1f6f5433; }
.wc-chip .wc-sw { width: 16px; height: 16px; }
