
/* 🎨 Wall colours panel (19 Nov 2026) */
#wcPanel { position: absolute; top: 10px; right: 10px; z-index: 32; width: 340px; max-height: calc(100% - 20px); display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 14px 40px rgba(0,0,0,.22); font-size: 12.5px; line-height: 1.4; }
#wcPanel.hidden { display: none; }
#wcPanel .wc-h { display: flex; gap: 8px; align-items: center; padding: 9px 12px; border-bottom: 1px solid var(--line); }
#wcPanel .wc-h b { flex: 1; font-size: 14px; }
#wcPanel .wc-h button { font-size: 12px; padding: 3px 8px; }
#wcPanel .wc-onoff.off { background: #1f6f54; color: #fff; border-color: #1f6f54; }
#wcPanel .wc-body { overflow-y: auto; padding: 4px 12px 12px; }
#wcPanel h5 { margin: 12px 0 6px; color: #7a5410; font-size: 12.5px; }
.wc-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.wc-card { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; text-align: left; padding: 7px 8px; border-radius: 10px; border: 1px solid var(--line); background: #faf9f6; cursor: pointer; font-size: 12px; }
.wc-card.on { border-color: #1f6f54; box-shadow: 0 0 0 2px #1f6f5433; background: #f1f8f4; }
.wc-card .wc-mood { color: #666; font-size: 11px; line-height: 1.25; }
.wc-strip { display: flex; gap: 2px; margin-top: 3px; }
.wc-sw { display: inline-block; width: 18px; height: 18px; border-radius: 5px; border: 1px solid rgba(0,0,0,.15); vertical-align: middle; }
.wc-sw.acc { border-radius: 50%; }
.wc-sw.none { background: repeating-linear-gradient(45deg, #eee, #eee 3px, #fff 3px, #fff 6px); text-align: center; font-size: 10px; line-height: 16px; color: #999; }
.wc-why { margin-top: 7px; background: #fff7e6; border-radius: 8px; padding: 6px 8px; color: #333; }
.wc-room { border-top: 1px solid var(--line); padding: 7px 0; }
.wc-rn { font-weight: 700; margin-bottom: 4px; }
.wc-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.wc-pick { display: flex; gap: 6px; align-items: center; text-align: left; padding: 5px 6px; border-radius: 9px; border: 1px solid var(--line); background: #fff; cursor: pointer; font-size: 11.5px; line-height: 1.25; }
.wc-pick .wc-sw { width: 30px; height: 30px; flex: none; }
.wc-pick a { color: #1f4f8a; }
.wc-code { color: #888; font-size: 11px; }
.wc-side { display: block; margin-top: 5px; font-size: 11.5px; color: #444; }
.wc-side select { font-size: 11.5px; }
.wc-side i { color: #888; font-style: normal; }
.wc-kept { color: #888; font-size: 11px; margin-top: 4px; }
.wc-list, .wc-tips { margin: 0; padding-left: 18px; display: grid; gap: 3px; }
.wc-src { margin-top: 10px; color: #777; font-size: 11px; } .wc-src a { color: #2563eb; }
.wc-pop { position: absolute; left: -260px; top: 60px; width: 250px; max-height: 70%; overflow-y: auto; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,.22); padding: 0 10px 10px; }
.wc-pop .wc-fam { margin-top: 6px; } .wc-pop .wc-fam i { font-style: normal; color: #666; font-size: 11px; }
.wc-pop .wc-fam div { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }
.wc-sw.big { width: 34px; height: 34px; cursor: pointer; padding: 0; }
.wc-sw.big:hover { outline: 2px solid #1f6f54; }
button.wcBtn.on { background: #1f6f54; color: #fff; }
@media (max-width: 760px) { #wcPanel { width: auto; left: 8px; right: 8px; max-height: 55%; top: auto; bottom: 8px; } .wc-pop { left: 8px; right: 8px; width: auto; top: 8px; } }
